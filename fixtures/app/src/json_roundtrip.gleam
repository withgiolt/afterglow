// Phase 1 benchmark fixture (new): decode 50136 bytes of JSON into typed
// records with gleam_json, then encode them again. Allocation-heavy parsing.
import gleam/dynamic/decode
import gleam/json
import afterglow
import wisp

pub fn start() {
  afterglow.serve(handle_request)
}

pub type Address {
  Address(city: String, zip: String)
}

pub type User {
  User(
    id: Int,
    name: String,
    email: String,
    active: Bool,
    score: Float,
    tags: List(String),
    address: Address,
  )
}

fn handle_request(_req: wisp.Request) -> wisp.Response {
  case json.parse(input, decode.list(user_decoder())) {
    Ok(users) ->
      json.array(users, encode_user)
      |> json.to_string
      |> wisp.json_response(200)
    Error(_) -> wisp.internal_server_error()
  }
}

fn user_decoder() -> decode.Decoder(User) {
  use id <- decode.field("id", decode.int)
  use name <- decode.field("name", decode.string)
  use email <- decode.field("email", decode.string)
  use active <- decode.field("active", decode.bool)
  use score <- decode.field("score", decode.float)
  use tags <- decode.field("tags", decode.list(decode.string))
  use address <- decode.field("address", {
    use city <- decode.field("city", decode.string)
    use zip <- decode.field("zip", decode.string)
    decode.success(Address(city:, zip:))
  })
  decode.success(User(id:, name:, email:, active:, score:, tags:, address:))
}

fn encode_user(u: User) -> json.Json {
  json.object([
    #("id", json.int(u.id)),
    #("name", json.string(u.name)),
    #("email", json.string(u.email)),
    #("active", json.bool(u.active)),
    #("score", json.float(u.score)),
    #("tags", json.array(u.tags, json.string)),
    #(
      "address",
      json.object([
        #("city", json.string(u.address.city)),
        #("zip", json.string(u.address.zip)),
      ]),
    ),
  ])
}

